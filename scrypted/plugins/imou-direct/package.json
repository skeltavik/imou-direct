      "DeviceProvider"
    ]
  },
  "devDependencies": {
    "@scrypted/sdk": "0.5.59",
    "@types/node": "24.19.2",
    "terser-webpack-plugin": "5.6.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "serialize-javascript": "7.1.4"
  }
}
