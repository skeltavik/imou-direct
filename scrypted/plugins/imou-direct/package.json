{
  "name": "@scrypted/imou-direct",
  "version": "0.1.0",
  "private": true,
  "description": "Experimental local Imou Doorbell plugin for Scrypted",
  "license": "MIT",
  "scripts": {
    "build": "scrypted-webpack",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "scrypted",
    "plugin",
    "imou",
    "doorbell"
  ],
  "scrypted": {
    "name": "Imou Direct",
